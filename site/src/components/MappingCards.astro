---
import Bell from '../assets/icons/bell.svg';
import Castle from '../assets/icons/castle.svg';
import Coins from '../assets/icons/coins.svg';
import Sword from '../assets/icons/sword.svg';

const mappings = [
  { icon: Sword, title: 'Guild Hall', body: 'Whole-party operational home.' },
  { icon: Castle, title: 'Delve', body: 'Active work in connected chambers.' },
  { icon: Bell, title: 'Summons', body: 'Blocked agents call for counsel.' },
  { icon: Coins, title: 'Spoils', body: 'Completed work returns for inspection.' },
];
---

<section class="section mapping-section" aria-labelledby="mapping-title">
  <div class="section-heading">
    <p class="section-kicker"><span aria-hidden="true">04</span> The Questmancer vocabulary</p>
    <h2 id="mapping-title">Fantasy language. Operational facts.</h2>
  </div>
  <div class="mapping-grid">
    {mappings.map((mapping) => (
      <article class="mapping-card">
        <div class="mapping-icon" aria-hidden="true">
          <mapping.icon width={24} height={24} aria-hidden="true" />
        </div>
        <div>
          <h3>{mapping.title}</h3>
          <p>{mapping.body}</p>
        </div>
      </article>
    ))}
  </div>
</section>
